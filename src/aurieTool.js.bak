import { getRequestAuth } from './requestContext.js';
import { callAuraAsk, bearerFromHeader, decodeOurJwt } from './auraDialogue.js';

const baseInputSchema = {
  type: 'object',
  properties: {
    text: {
      type: 'string',
      description:
        [
          "The user's current message (what they're feeling right now).",
          'Include the full text (even if messy).',
          'Examples:',
          '- "I feel overwhelmed and I can’t focus."',
          '- "My chest feels tight and I’m spiraling."',
          '- "I need grounding right now."',
        ].join('\n'),
    },
    conversationId: {
      type: 'string',
      description:
        'Optional. Pass the conversationId from the previous tool result so this message continues the same conversation (up to 10 user messages).',
    },
    dialogueId: {
      type: 'string',
      description:
        'Optional. Pass the dialogueId from the previous tool result when continuing a conversation.',
    },
  },
  required: ['text'],
};

const MAX_USER_MESSAGES = 10;
const conversationMessageCount = new Map();

export const aurieQuickProcessTool = {
  name: 'aurie.quick_process',
  opensWidget: true,
  description: [
    'Use this when the user is emotionally flooded or dysregulated and wants quick grounding / settling in the moment.',
    '',
    'This opens the Aurie Quick Processing widget (a short, contained flow) and returns the user back to the chat.',
    '',
    'Use for prompts like:',
    '- "I feel overwhelmed."',
    '- "I’m anxious and can’t calm down."',
    '- "I can’t stop spiraling."',
    '- "I feel emotionally stuck."',
    '- "I don’t know why I feel this way."',
    '- "Everything feels heavy but I can’t explain it."',
    '- "I need grounding right now."',
    '- "Help me process this."',
    '- "My chest feels tight and I can’t think clearly."',
    '',
    'Do NOT use for:',
    '- general life coaching / long plans / habit tracking',
    '- medical advice, diagnosis, or treatment',
    '- unrelated requests (jokes, coding, shopping, etc.)',
    '',
    'Important: pass the user message through as `text` exactly as written.',
  ].join('\n'),
  inputSchema: baseInputSchema,
  handler: async (args) => {
    const userMessage = typeof args?.text === 'string' ? args.text : '';
    const conversationId = typeof args?.conversationId === 'string' ? args.conversationId : null;
    const dialogueId = typeof args?.dialogueId === 'string' ? args.dialogueId : null;
    const authorization = getRequestAuth();
    const rawToken = bearerFromHeader(authorization);
    const ourJwt = rawToken ? decodeOurJwt(rawToken) : null;
    const accessToken = ourJwt?.aura_token || rawToken;

    if (!accessToken) {
      return {
        response:
          'Connect your Aurie account to use Quick Processing here. In ChatGPT, add this app and choose "OAuth" to link your account.',
        initial_text: userMessage,
        first_reply: null,
        connect_required: true,
      };
    }

    if (conversationId) {
      const count = (conversationMessageCount.get(conversationId) ?? 0) + 1;
      if (count > MAX_USER_MESSAGES) {
        return {
          response: `This Quick Processing conversation has reached the maximum of ${MAX_USER_MESSAGES} messages. Start a new message to begin a fresh conversation.`,
          initial_text: userMessage,
          first_reply: null,
          conversationId,
          dialogueId,
          connect_required: false,
          message_limit_reached: true,
        };
      }
      conversationMessageCount.set(conversationId, count);
    }

    const result = await callAuraAsk({
      message: userMessage,
      conversationId,
      accessToken,
    });
      if (result.success) {
        return {
          response: result.message || 'Here’s a moment of grounding.',
          initial_text: userMessage,
          first_reply: result.message,
          conversationId: (result.conversationId ?? conversationId),
          dialogueId: (result.dialogueId ?? dialogueId),
          connect_required: false,
        };
      }
      return {
        response: result.error || 'Something went wrong. Try again.',
        initial_text: userMessage,
        first_reply: null,
        connect_required: false,
      };
    }

    return {
      response:
        'Connect your Aurie account to use Quick Processing here. In ChatGPT, add this app and choose “OAuth” to link your account.',
      initial_text: userMessage,
      first_reply: null,
      connect_required: true,
    };
  },
};

export const aurieAliasTool = {
  name: 'aurie',
  opensWidget: true,
  description: [
    'Aurie (alias) — opens Aurie Quick Processing.',
    '',
    'Use this when the user explicitly names Aurie, like:',
    '- "Aurie, I feel overwhelmed."',
    '- "Open Aurie — I’m spiraling."',
    '- "Aurie help me calm down."',
    '',
    'If the user does not explicitly name Aurie, prefer `aurie.quick_process`.',
  ].join('\n'),
  inputSchema: baseInputSchema,
  handler: aurieQuickProcessTool.handler,
};

export const allTools = [aurieQuickProcessTool, aurieAliasTool];


